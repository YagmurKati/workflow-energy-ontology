# Workflow Energy Ontology, research software module, version 0.9.3 (2026-11-08).
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix bibo:  <http://purl.org/ontology/bibo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rm:    <http://example.org/ontology/run-metadata#> .

<http://example.org/ontology/run-metadata/research-software> a owl:Ontology ;
    rdfs:label "Research software module of the Workflow Energy Ontology"@en ;
    owl:imports <http://example.org/ontology/run-metadata> ;
    dcterms:creator "Yagmur Kati" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.9.3 (2026-11-08)" ;
    rdfs:comment "Optional categories of research software around workflows: benchmarks and datasets, data systems, workflow environments and deployment, workflow scheduling, workflow tools and plugins. 5 classes. Their properties (purpose, code link, responsible researcher, publications, engine, cluster, backend) are in the core."@en .

# ---- Classes

rm:BenchmarkDataset a owl:Class ;
    rdfs:label "Benchmarks and Datasets"@en-US .

rm:DataSystem a owl:Class ;
    rdfs:label "Data Systems"@en-US .

rm:WorkflowEnvironment a owl:Class ;
    rdfs:label "Workflow Environments and Deployment"@en-US .

rm:WorkflowScheduling a owl:Class ;
    rdfs:label "Workflow Scheduling"@en-US .

rm:WorkflowToolPlugin a owl:Class ;
    rdfs:label "Workflow Tools and Plugins"@en-US .
